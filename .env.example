# PocketSmart AI - configuration
# Copy this file to `.env` and fill in your values.

# --- Gemini ---------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# The design document used the name `Gemini_Api_Key`; all of these work:
GEMINI_API_KEY=

# Model used for planning. The 1.5 family from the design document has been
# retired; this is the current Flash-tier equivalent. Pin your own if needed.
GEMINI_MODEL=gemini-3.8-flash

# Tried in order if the primary model is retired or unavailable.
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.7-flash,gemini-flash-latest

# Set to true to always use the offline engine (demos, offline work, tests).
FORCE_MOCK_AI=false

# Per-attempt timeout and retry budget before falling back to the offline engine.
AI_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=2
AI_RETRY_BACKOFF_SECONDS=1.5

# --- Web ------------------------------------------------------------------
APP_NAME=PocketSmart AI

# CHANGE THIS before deploying. It signs the session cookies.
SECRET_KEY=pocketsmart-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Storage --------------------------------------------------------------
DATABASE_PATH=pocketsmart.db

# --- Dev server -----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
