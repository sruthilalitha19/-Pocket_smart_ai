# Local configuration. This file is git-ignored - never commit real keys.
# Copy .env.example to .env and fill in your own values.

# --- Gemini ---------------------------------------------------------------
# Leave empty to run fully offline on the built-in engine.
GEMINI_API_KEY=

# Model used for planning.
GEMINI_MODEL=gemini-3.8-flash

# Tried in order if the primary model is retired or unavailable.
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.7-flash,gemini-flash-latest

# true = always use the offline engine (demos, offline work, tests).
FORCE_MOCK_AI=false

AI_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=2
AI_RETRY_BACKOFF_SECONDS=1.5

# --- Web ------------------------------------------------------------------
APP_NAME=PocketSmart AI

# CHANGE THIS before deploying - it signs the session cookies.
SECRET_KEY=pocketsmart-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Storage --------------------------------------------------------------
DATABASE_PATH=pocketsmart.db

# --- Dev server -----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
